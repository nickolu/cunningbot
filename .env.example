# .env.example
# Example environment variables for the bot

# Discord Configuration
DISCORD_TOKEN=${DISCORD_TOKEN}
CLIENT_ID=<PASTE_CLIENT_ID_HERE>
INVITE_URL=<PASTE_OAUTH_URL_HERE>

# API Keys
OPENAI_API_KEY=${OPENAI_API_KEY}
GOOGLE_API_KEY=${GOOGLE_API_KEY}
PERPLEXITY_API_KEY=

# Redis Configuration
REDIS_HOST=redis              # Docker service name (use 'localhost' for local dev)
REDIS_PORT=6379
REDIS_DB=0                    # Use DB 0 for production
REDIS_PASSWORD=               # Optional password (leave empty for no auth)
# --- Published pages (the Vercel app in web/) ---
# Base URL of the deployed pages service, no trailing slash.
PAGES_BASE_URL=https://your-project.vercel.app
# Shared secret; must equal PUBLISH_TOKEN in the Vercel project's env vars.
PAGES_PUBLISH_TOKEN=
# Secret used to derive per-guild page ids. Never leaves the bot host —
# do NOT add this one to Vercel. Generate with: openssl rand -hex 32
PAGES_ID_SECRET=
